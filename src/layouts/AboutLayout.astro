---
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import Icon from "@/components/Icon.astro";
import DaveOsLogo from "@/components/DaveOsLogo.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

type Props = { frontmatter: { title: string; description?: string } };
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`} description={frontmatter.description}>
  <Panel class="about-panel">
    <div class="about">
      <header class="about__header">
        <img class="about__avatar" src={SITE.avatar.src} alt={SITE.avatar.alt} width="96" height="96" />
        <div>
          <h1 class="page-heading">{SITE.author}</h1>
          <p class="page-lede">System Architect, professional coffee-to-distributed-systems converter. MonkeyProof is where the leftovers go.</p>
          <div class="about__links">
            <a class="action action--primary" href={SITE.daveos.url} data-daveos>
              <DaveOsLogo /> Open {SITE.daveos.label}
            </a>
            {
              SOCIALS.map(s => (
                <a class="share-like" href={s.href} aria-label={s.linkTitle} title={s.name} rel="me noopener" target={s.href.startsWith("http") ? "_blank" : undefined}>
                  <Icon name={s.icon} />
                </a>
              ))
            }
          </div>
        </div>
      </header>
      <div class="prose about__body">
        <slot />
      </div>
    </div>
  </Panel>
</Layout>

<style>
  .about-panel {
    max-width: 960px;
    margin-inline: auto;
  }

  .about {
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  .about__header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }

  .about__avatar {
    width: clamp(72px, 12vw, 112px);
    height: auto;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 20px 40px -24px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .about__links .action :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .share-like {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    transition: color 150ms ease, border-color 150ms ease, transform 260ms var(--ease-spring);
  }

  .share-like:hover {
    transform: rotate(-8deg);
    color: var(--window-text);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .share-like :global(.icon) {
    width: 19px;
    height: 19px;
  }

  .about__body {
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
  }

  @media (max-width: 560px) {
    .about__header {
      grid-template-columns: 1fr;
    }
  }
</style>
