---
/**
 * Spotlight search (⌘K / Ctrl K / "/"), backed by the Pagefind index that
 * `npm run build` generates. Without JavaScript the menu bar button is
 * inert and /search/ still works as a page.
 */
import Icon from "@/components/Icon.astro";
import { NAV_LINKS } from "@/constants";
---

<dialog id="spotlight" class="spotlight" aria-label="Search articles">
  <div class="spotlight__panel">
    <form class="spotlight__field" role="search" method="dialog" data-spotlight-form>
      <Icon name="search" />
      <input
        type="search"
        name="q"
        placeholder="Search the chaos…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search articles"
        aria-controls="spotlight-results"
        aria-autocomplete="list"
        data-spotlight-input
      />
      <kbd class="spotlight__kbd">esc</kbd>
    </form>

    <div class="spotlight__body">
      <p class="spotlight__group" data-spotlight-heading>Jump to</p>
      <ul id="spotlight-results" class="spotlight__results" role="listbox" data-spotlight-results>
        {
          NAV_LINKS.map(link => (
            <li role="option" aria-selected="false">
              <a class="spotlight__result" href={link.href}>
                <span class="spotlight__result-icon"><Icon name={link.icon} /></span>
                <span class="spotlight__result-text">
                  <span class="spotlight__result-title">{link.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="spotlight__status" role="status" aria-live="polite" data-spotlight-status></p>
    </div>

    <footer class="spotlight__foot">
      <span><kbd class="spotlight__kbd">↑</kbd><kbd class="spotlight__kbd">↓</kbd> navigate</span>
      <span><kbd class="spotlight__kbd">↵</kbd> open</span>
    </footer>
  </div>
</dialog>

<script>
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string };
  };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (
      q: string,
      opts?: object,
      ms?: number
    ) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  let pagefind: Pagefind | null = null;
  let pagefindFailed = false;
  let defaultResults = "";
  let active = -1;

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel);

  const loadPagefind = async () => {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      const path = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
      await pagefind.init();
    } catch {
      pagefindFailed = true;
    }
    return pagefind;
  };

  const options = () =>
    Array.from(document.querySelectorAll<HTMLLIElement>("[data-spotlight-results] > li"));

  const setActive = (index: number) => {
    const items = options();
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((li, i) => {
      li.setAttribute("aria-selected", String(i === active));
      li.querySelector("a")?.classList.toggle("is-active", i === active);
    });
    items[active]?.scrollIntoView({ block: "nearest" });
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, ch => `&#${ch.charCodeAt(0)};`);

  const renderResults = (results: PagefindResult[], query: string) => {
    const list = $<HTMLUListElement>("[data-spotlight-results]");
    const heading = $<HTMLElement>("[data-spotlight-heading]");
    const status = $<HTMLElement>("[data-spotlight-status]");
    if (!list || !heading || !status) return;

    heading.textContent = results.length ? "Found these" : "";
    status.textContent = results.length
      ? `${results.length} result${results.length === 1 ? "" : "s"}`
      : `Nothing matches “${query}”. Even the monkeys looked twice. Try a broader term.`;

    // Excerpts come from Pagefind and only contain <mark> highlights.
    list.innerHTML = results
      .map(
        r => `<li role="option" aria-selected="false">
          <a class="spotlight__result" href="${escapeHtml(r.url)}">
            <span class="spotlight__result-text">
              <span class="spotlight__result-title">${escapeHtml(r.meta.title ?? r.url)}</span>
              <span class="spotlight__result-excerpt">${r.excerpt}</span>
            </span>
          </a>
        </li>`
      )
      .join("");
    active = -1;
    if (results.length) setActive(0);
  };

  const restoreDefault = () => {
    const list = $<HTMLUListElement>("[data-spotlight-results]");
    const heading = $<HTMLElement>("[data-spotlight-heading]");
    const status = $<HTMLElement>("[data-spotlight-status]");
    if (list && defaultResults) list.innerHTML = defaultResults;
    if (heading) heading.textContent = "Jump to";
    if (status) status.textContent = "";
    active = -1;
  };

  const search = async (query: string) => {
    const q = query.trim();
    if (!q) return restoreDefault();
    const pf = await loadPagefind();
    if (!pf) {
      const status = $<HTMLElement>("[data-spotlight-status]");
      if (status)
        status.textContent = "Search index not found. It is generated by `npm run build`.";
      return;
    }
    const res = await pf.debouncedSearch(q, {}, 180);
    if (!res) return; // superseded by a newer query
    const data = await Promise.all(res.results.slice(0, 8).map(r => r.data()));
    renderResults(data, q);
  };

  const open = () => {
    const dialog = $<HTMLDialogElement>("#spotlight");
    const input = $<HTMLInputElement>("[data-spotlight-input]");
    if (!dialog || dialog.open) return;
    defaultResults ||= $("[data-spotlight-results]")?.innerHTML ?? "";
    dialog.showModal();
    input?.select();
    void loadPagefind();
  };

  const close = () => $<HTMLDialogElement>("#spotlight")?.close();

  document.addEventListener("keydown", event => {
    const target = event.target as HTMLElement;
    const typing = target.matches("input, textarea, [contenteditable]");
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      open();
    } else if (event.key === "/" && !typing) {
      event.preventDefault();
      open();
    }
  });

  document.addEventListener("click", event => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-open-search]")) {
      open();
      return;
    }
    const dialog = $<HTMLDialogElement>("#spotlight");
    if (dialog?.open && target === dialog) close(); // click on the backdrop
    if (target.closest(".spotlight__result")) close();
  });

  document.addEventListener("input", event => {
    const target = event.target as HTMLElement;
    if (target.matches("[data-spotlight-input]")) {
      void search((target as HTMLInputElement).value);
    }
  });

  document.addEventListener("keydown", event => {
    const dialog = $<HTMLDialogElement>("#spotlight");
    if (!dialog?.open) return;
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === "Enter") {
      const link = options()[active]?.querySelector("a");
      if (link) {
        event.preventDefault();
        close();
        link.click();
      }
    }
  });

  document.addEventListener("astro:page-load", () => {
    const isMac = /mac|iphone|ipad/i.test(navigator.platform);
    document.querySelectorAll("[data-shortcut-label]").forEach(el => {
      el.textContent = isMac ? "⌘K" : "Ctrl K";
    });
    defaultResults = "";
  });
</script>

<style is:global>
  .spotlight {
    width: min(640px, calc(100vw - 1.5rem));
    max-height: min(560px, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--window-text);
    overflow: visible;
  }

  .spotlight::backdrop {
    background: #05060b66;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .spotlight[open] .spotlight__panel {
    animation: spotlight-in 220ms var(--ease-out);
  }

  @keyframes spotlight-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .spotlight__panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    background: color-mix(in srgb, var(--window-bg) 96%, transparent);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 40px 100px -20px #000000cc,
      0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
  }

  .spotlight__field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--window-text) 10%, transparent);
  }

  .spotlight__field > .icon {
    width: 20px;
    height: 20px;
    color: var(--muted);
  }

  .spotlight__field input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    color: var(--window-text);
    font: inherit;
    font-size: 1.08rem;
    outline: none;
  }

  .spotlight__field input::placeholder {
    color: var(--muted);
  }

  .spotlight__field input::-webkit-search-cancel-button {
    display: none;
  }

  .spotlight__body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .spotlight__group {
    margin: 0.35rem 0.5rem 0.4rem;
    font-family: var(--hand);
    font-size: 16px;
    color: var(--muted);
  }

  .spotlight__group:empty {
    display: none;
  }

  .spotlight__results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spotlight__result {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border-radius: 14px;
  }

  .spotlight__result:hover,
  .spotlight__result.is-active {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .spotlight__result-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 9px;
    background: color-mix(in srgb, var(--window-text) 7%, transparent);
  }

  .spotlight__result-icon .icon {
    width: 17px;
    height: 17px;
  }

  .spotlight__result-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .spotlight__result-title {
    font-weight: 600;
  }

  .spotlight__result-excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .spotlight__result-excerpt mark {
    background: transparent;
    color: var(--link);
    font-weight: 600;
  }

  .spotlight__status {
    margin: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .spotlight__status:empty {
    display: none;
  }

  .spotlight__foot {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--window-text) 10%, transparent);
    color: var(--muted);
    font-size: 12px;
  }

  .spotlight__kbd {
    display: inline-block;
    margin-right: 0.2rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--window-text) 18%, transparent);
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .spotlight {
      margin-top: calc(var(--menubar-h) + 0.75rem);
    }

    .spotlight__foot {
      display: none;
    }
  }
</style>
