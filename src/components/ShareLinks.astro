---
import Icon from "@/components/Icon.astro";
import { SHARE_LINKS } from "@/constants";

type Props = { title: string };
const { title } = Astro.props;
const url = Astro.url.href;
---

<div class="share" data-pagefind-ignore>
  <p class="share__label" id="share-label">Liked it? Pass it on</p>
  <ul class="share__list" aria-labelledby="share-label">
    {
      SHARE_LINKS.map(s => (
        <li>
          <a
            class="share__btn"
            href={`${s.href}${encodeURIComponent(s.name === "Mail" ? `${title} — ${url}` : url)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.linkTitle}
            title={s.linkTitle}
          >
            <Icon name={s.icon} />
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" class="share__btn" data-copy-link={url} aria-label="Copy link" title="Copy link">
        <Icon name="link" />
      </button>
    </li>
  </ul>
</div>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .share__label {
    margin: 0;
    font-family: var(--hand);
    font-size: 17px;
    color: var(--muted);
  }

  .share__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    transition: color 150ms ease, border-color 150ms ease, transform 260ms var(--ease-spring);
  }

  .share__btn:hover,
  .share__btn:focus-visible {
    transform: translateY(-2px) rotate(-8deg);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--window-text);
  }

  .share__btn[data-copied] {
    color: #34d399;
  }

  .share__btn .icon {
    width: 18px;
    height: 18px;
  }
</style>
