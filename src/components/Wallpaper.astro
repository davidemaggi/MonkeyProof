---
/* The DaveOS desktop wallpaper. Colors come from [data-wallpaper] tokens. */
---

<div class="wallpaper" aria-hidden="true" transition:persist="wallpaper">
  <div class="wallpaper__blob wallpaper__blob--1"></div>
  <div class="wallpaper__blob wallpaper__blob--2"></div>
  <div class="wallpaper__blob wallpaper__blob--3"></div>
  <div class="wallpaper__blob wallpaper__blob--4"></div>
  <div class="wallpaper__stars wallpaper__stars--far"></div>
  <div class="wallpaper__stars"></div>
  <div class="wallpaper__grid"></div>
  <div class="wallpaper__glow"></div>
  <div class="wallpaper__saber"></div>
  <div class="wallpaper__grain"></div>
  <div class="wallpaper__vignette"></div>
</div>
