---
import type { Page } from "astro";
import Icon from "@/components/Icon.astro";

type Props = { page: Page; noun?: string };
const { page, noun = "posts" } = Astro.props;
---

<div class="panel__footer">
  <span>
    {page.total} {noun}
    {page.lastPage > 1 && <> · page {page.currentPage} of {page.lastPage}</>}
  </span>
  {
    page.lastPage > 1 && (
      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? (
          <a class="pager__btn" href={page.url.prev} rel="prev">
            <Icon name="chevron-left" /> Newer
          </a>
        ) : (
          <span class="pager__btn" aria-disabled="true">
            <Icon name="chevron-left" /> Newer
          </span>
        )}
        {page.url.next ? (
          <a class="pager__btn" href={page.url.next} rel="next">
            Older <Icon name="chevron-right" />
          </a>
        ) : (
          <span class="pager__btn" aria-disabled="true">
            Older <Icon name="chevron-right" />
          </span>
        )}
      </nav>
    )
  }
</div>

<style>
  .pager {
    display: flex;
    gap: 6px;
  }

  .pager__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
    padding: 0 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--window-bg);
    color: var(--window-text);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }

  a.pager__btn:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .pager__btn[aria-disabled="true"] {
    opacity: 0.4;
  }
</style>
