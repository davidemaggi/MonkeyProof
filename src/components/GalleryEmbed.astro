---
/**
 * GalleryEmbed — an inline grid of a gallery inside an MDX post.
 *
 *   <GalleryEmbed slug="gallery-folder-name" />
 *
 * Props:
 *   slug      — folder name in src/data/galleries/ (required)
 *   limit     — maximum images shown (default 6; 0 = all)
 *   showLink  — show "Open the full gallery" (default true)
 *   cols      — grid columns: 2 | 3 | 4 (default 3)
 */
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "@/components/Icon.astro";
import Lightbox from "@/components/Lightbox.astro";
import { getGallerySlug } from "@/utils/contentEntry";
import { getGalleryImages } from "@/utils/galleryImages";
import { SITE } from "@/config";

type Props = {
  slug: string;
  limit?: number;
  showLink?: boolean;
  cols?: 2 | 3 | 4;
};

const { slug, limit = 6, showLink = true, cols = 3 } = Astro.props;

const entry = (await getCollection("galleries")).find(
  g => getGallerySlug(g.id.replace(/\\/g, "/")) === slug
);
const images = getGalleryImages(slug, entry?.data.title);
const visible = limit > 0 ? images.slice(0, limit) : images;
const remaining = images.length - visible.length;
const full = await Promise.all(visible.map(img => getImage({ src: img.src, width: Math.min(img.src.width, 2000) })));
---

{
  !entry ? (
    <p class="gallery-embed__error">
      Gallery <code>{slug}</code> not found. Check that <code>src/data/galleries/{slug}/index.md</code> exists.
    </p>
  ) : (
    <figure class="gallery-embed" data-pagefind-ignore>
      <figcaption class="gallery-embed__head">
        <Icon name="photo" />
        <span class="gallery-embed__title">{entry.data.title}</span>
        <span class="meta">{images.length} photos</span>
      </figcaption>
      <ul class="gallery-embed__grid" style={`--cols: ${cols}`}>
        {visible.map((img, i) => (
          <li>
            <button type="button" class="gallery-embed__item" data-lightbox={`embed-${slug}`} data-full={full[i].src} data-alt={img.alt} aria-label={`Open image: ${img.alt}`}>
              <Image src={img.src} alt={img.alt} widths={[300, 600]} sizes={`(max-width: 640px) 50vw, ${Math.round(100 / cols)}vw`} />
            </button>
          </li>
        ))}
      </ul>
      {showLink && SITE.showGalleries && (
        <a class="link-arrow gallery-embed__link" href={`/galleries/${slug}/`}>
          Open the full gallery{remaining > 0 && ` (+${remaining})`} <Icon name="arrow-right" />
        </a>
      )}
    </figure>
  )
}
<Lightbox />

<style>
  .gallery-embed {
    margin: 2em 0 0;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-2);
  }

  .gallery-embed__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    text-align: left;
  }

  .gallery-embed__title {
    flex: 1;
    font-family: var(--display);
    font-weight: 600;
    color: var(--prose-strong);
  }

  .gallery-embed__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-embed__grid li::before {
    display: none;
  }

  .gallery-embed__item {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 10px;
    background: var(--surface-3);
  }

  .gallery-embed__item :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    transition: transform 400ms var(--ease-out);
  }

  .gallery-embed__item:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-embed__link {
    margin-top: 0.85rem;
    text-decoration: none !important;
  }

  .gallery-embed__error {
    padding: 0.75rem 1rem;
    border: 1px solid #f8717166;
    border-radius: 10px;
    background: #f871711a;
  }

  @media (max-width: 640px) {
    .gallery-embed__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
