---
import Icon from "@/components/Icon.astro";
import DaveOsLogo from "@/components/DaveOsLogo.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const year = new Date().getFullYear();
---

<footer class="dock-footer">
  <div class="dock glass glass-blur">
    <a class="dock__item dock__daveos" href={SITE.daveos.url} data-daveos>
      <DaveOsLogo />
      <span>{SITE.daveos.label}</span>
    </a>
    <span class="dock__sep" aria-hidden="true"></span>
    {
      SOCIALS.map(s => (
        <a class="dock__item" href={s.href} title={s.linkTitle} aria-label={s.linkTitle} rel="me noopener" target={s.href.startsWith("http") ? "_blank" : undefined}>
          <Icon name={s.icon} />
        </a>
      ))
    }
    <a class="dock__item" href="/rss.xml" title="RSS feed" aria-label="RSS feed">
      <Icon name="rss" />
    </a>
  </div>
  <p class="dock-footer__legal">
    © {year} {SITE.author}. Written by a human, proofread by a monkey.
  </p>
</footer>

<style>
  .dock-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 2.5rem var(--page-gutter) max(2rem, env(safe-area-inset-bottom));
    color: var(--ground-text);
  }

  .dock {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 18px;
  }

  .dock__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    height: 44px;
    padding: 0 0.7rem;
    border-radius: 12px;
    transition: background 160ms ease, transform 180ms var(--ease-out);
  }

  .dock__item:hover,
  .dock__item:focus-visible {
    background: color-mix(in srgb, var(--glass-text) 12%, transparent);
    transform: translateY(-3px);
  }

  .dock__item .icon {
    width: 20px;
    height: 20px;
  }

  .dock__daveos {
    font-family: var(--display);
    font-weight: 600;
    font-size: 14px;
  }

  .dock__sep {
    width: 1px;
    height: 28px;
    margin: 0 4px;
    background: var(--glass-border);
  }

  .dock-footer__legal {
    margin: 0;
    font-size: 12.5px;
    opacity: 0.7;
    text-align: center;
  }
</style>
