---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import PostRow from "@/components/PostRow.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const [blogPosts, galleryPosts] = await Promise.all([
    getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft),
    SITE.showGalleries && SITE.showGalleriesInIndex
      ? getCollection("galleries", ({ data }) => import.meta.env.DEV || !data.draft)
      : Promise.resolve([]),
  ]);
  return paginate(getSortedPosts([...blogPosts, ...galleryPosts]), {
    pageSize: SITE.postPerPage,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const title = page.currentPage > 1 ? `Posts · page ${page.currentPage}` : "Posts";
---

<Layout title={`${title} | ${SITE.title}`} description="Every article on MonkeyProof, newest first.">
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading">Posts</h1>
      <p class="page-lede">Architecture, backend engineering, distributed systems, and the experiments in between. Newest first, so the freshest mistakes are on top.</p>
    </header>
    <ul class="post-list">
      {page.data.map((entry, i) => <PostRow entry={entry} headingLevel="h2" eager={i === 0} />)}
    </ul>
    <Pagination slot="footer" page={page} />
  </Panel>
</Layout>
