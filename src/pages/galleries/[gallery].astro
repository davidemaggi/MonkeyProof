---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import Lightbox from "@/components/Lightbox.astro";
import { getGallerySlug } from "@/utils/contentEntry";
import { getGalleryImages } from "@/utils/galleryImages";
import { formatDate } from "@/utils/format";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

export async function getStaticPaths() {
  if (!SITE.showGalleries) return [];
  const galleries = await getCollection("galleries", ({ data }) => import.meta.env.DEV || !data.draft);
  return galleries.map(entry => ({
    params: { gallery: getGallerySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { gallery: slug } = Astro.params;
const { title, description, pubDatetime, tags } = entry.data;
const images = getGalleryImages(slug, title);
const full = await Promise.all(images.map(img => getImage({ src: img.src, width: Math.min(img.src.width, 2000) })));
---

<Layout title={`${title} | Galleries | ${SITE.title}`} description={description}>
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading" transition:name={`gallery-${slug}`}>{title}</h1>
      {description && <p class="page-lede">{description}</p>}
      <p class="meta gallery-meta">{formatDate(pubDatetime)} · {images.length} photos</p>
      {
        tags.length > 0 && (
          <ul class="gallery-tags">
            {tags.map(tag => (
              <li>
                <a class="tag" href={`/tags/${slugifyStr(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      images.length ? (
        <ul class="masonry">
          {images.map((img, i) => (
            <li>
              <button type="button" class="masonry__item" data-lightbox="gallery" data-full={full[i].src} data-alt={img.alt} aria-label={`Open image: ${img.alt}`}>
                <Image src={img.src} alt={img.alt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px" loading={i < 6 ? "eager" : "lazy"} />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="page-lede masonry-empty">This gallery has no images yet.</p>
      )
    }
  </Panel>
  <Lightbox />
</Layout>

<style>
  .gallery-meta {
    margin: 1rem 0 0;
  }

  .gallery-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .masonry {
    columns: 3 280px;
    column-gap: 0.75rem;
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem);
    list-style: none;
  }

  .masonry li {
    margin-bottom: 0.75rem;
    break-inside: avoid;
  }

  .masonry__item {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-2);
  }

  .masonry__item :global(img) {
    width: 100%;
    height: auto;
    transition: transform 500ms var(--ease-out);
  }

  .masonry__item:hover :global(img) {
    transform: scale(1.03);
  }

  .masonry-empty {
    padding: 2rem;
  }
</style>
