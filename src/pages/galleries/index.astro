---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import { getGallerySlug } from "@/utils/contentEntry";
import { getGalleryImages } from "@/utils/galleryImages";
import { formatDate } from "@/utils/format";
import { SITE } from "@/config";

if (!SITE.showGalleries) {
  return Astro.redirect("/404");
}

const galleries = (await getCollection("galleries", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .map(gallery => {
    const slug = getGallerySlug(gallery.id);
    const images = getGalleryImages(slug, gallery.data.title);
    return { gallery, slug, cover: gallery.data.coverImage ?? images[0]?.src, count: images.length };
  });
---

<Layout title={`Galleries | ${SITE.title}`} description="Photo collections from MonkeyProof.">
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading">Galleries</h1>
      <p class="page-lede">Photos of places, projects, and the occasional whiteboard nobody was supposed to see.</p>
    </header>
    {
      galleries.length ? (
        <ul class="galleries">
          {galleries.map(({ gallery, slug, cover, count }) => (
            <li class="gallery-tile">
              <a href={`/galleries/${slug}/`} class="gallery-tile__link">
                <span class="gallery-tile__media">
                  {cover && <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" />}
                </span>
                <span class="gallery-tile__title" transition:name={`gallery-${slug}`}>{gallery.data.title}</span>
                <span class="meta">{formatDate(gallery.data.pubDatetime)} · {count} photos</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="page-lede galleries-empty hand">No galleries yet. The camera is still in its box.</p>
      )
    }
    <div slot="footer" class="panel__footer"><span>{galleries.length} galleries</span></div>
  </Panel>
</Layout>

<style>
  .galleries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem);
    list-style: none;
  }

  .gallery-tile__link {
    display: grid;
    gap: 0.35rem;
  }

  .gallery-tile__media {
    display: block;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-2);
    aspect-ratio: 4 / 3;
  }

  .gallery-tile__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .gallery-tile__link:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-tile__title {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--prose-strong);
  }

  .galleries-empty {
    padding: 2rem;
  }
</style>
