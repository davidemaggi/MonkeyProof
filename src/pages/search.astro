---
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/config";
---

<Layout title={`Search | ${SITE.title}`} description="Search every MonkeyProof article.">
  <Panel>
    <div class="search-page">
      <h1 class="page-heading">Search</h1>
      <p class="page-lede">Full-text search over every article. Lost something? Hit <kbd class="kbd" data-shortcut-label>⌘K</kbd> from anywhere.</p>
      <button type="button" class="action action--primary search-page__open" data-open-search>
        <Icon name="search" /> Open search
      </button>
    </div>
  </Panel>
</Layout>

<script>
  // Arriving here (e.g. from an old link) opens Spotlight straight away.
  document.addEventListener("astro:page-load", () => {
    if (location.pathname.startsWith("/search")) {
      document.querySelector<HTMLButtonElement>(".search-page__open")?.click();
    }
  });
</script>

<style>
  .search-page {
    padding: clamp(2rem, 6vw, 3.5rem);
  }

  .search-page__open {
    margin-top: 1.5rem;
  }
</style>
