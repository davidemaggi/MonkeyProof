---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import PostRow from "@/components/PostRow.astro";
import Icon from "@/components/Icon.astro";
import AudioControl from "@/components/AudioControl.astro";
import Banana from "@/components/Banana.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getEntryPath } from "@/utils/contentEntry";
import { formatDate } from "@/utils/format";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex ? getCollection("galleries") : Promise.resolve([]),
]);
const posts = getSortedPosts([...blogPosts, ...galleryPosts]);

const featured = posts.find(({ data }) => "featured" in data && data.featured);
const latest = posts[0];
const lead = latest;
const rest = posts.filter(p => p !== lead).slice(0, SITE.postPerIndex - 1);

const topics = getUniqueTags(posts)
  .map(t => ({ ...t, count: getPostsByTag(posts, t.tag).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 8);

const { prefix, path, suffix } = SITE.heroTerminalPrompt;
---

<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="hero__prompt">
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span class="hero__prompt-text">
          <span class="hero__prompt-prefix">{prefix}</span>{path}
          <span class="hero__prompt-suffix">{suffix}</span>
        </span>
        <span class="hero__caret" aria-hidden="true"></span>
      </p>

      <div class="hero__title-wrap">
        <h1 id="hero-title" class="hero__name banana-wiggle">
          <span class="hero__name-line">Monkey<Banana size={96} class="hero__banana" /></span>
          <span class="hero__name-line hero__name-outline">Proof</span>
        </h1>
        <p class="hero__scribble hand" aria-hidden="true">
          <svg class="hero__scribble-arrow" viewBox="0 0 80 50" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M74 8C58 4 34 8 20 24c-5 6-8 12-9 19" />
            <path d="M4 34l7 10 9-8" />
          </svg>
          technically accurate chaos
        </p>
      </div>

      <p class="hero__tagline">
        A space where curiosity grabs a keyboard, breaks a few things, and somehow ships to production.
        Software architecture, backend engineering, and all the invisible duct tape that keeps the tech world spinning.
      </p>

      <div class="hero__actions">
        {
          latest && (
            <a class="action action--primary" href={getEntryPath(latest)}>
              Read the freshest one
              <Icon name="arrow-right" />
            </a>
          )
        }
        <a class="action glass" href="/posts/">
          <Icon name="notes" /> All posts
        </a>
        <button type="button" class="action glass" data-open-search>
          <Icon name="search" /> Dig around <kbd data-shortcut-label>⌘K</kbd>
        </button>
      </div>

      <ul class="hero__socials" aria-label="Elsewhere">
        {
          SOCIALS.map(s => (
            <li>
              <a
                class="icon-square glass"
                href={s.href}
                aria-label={s.linkTitle}
                title={s.name}
                rel="me noopener"
                target={s.href.startsWith("http") ? "_blank" : undefined}
              >
                <Icon name={s.icon} />
              </a>
            </li>
          ))
        }
        <li>
          <a class="icon-square glass" href="/rss.xml" aria-label="RSS feed" title="RSS">
            <Icon name="rss" />
          </a>
        </li>
      </ul>
    </div>

    <aside class="hero__widgets" aria-label="At a glance">
      {
        (featured ?? latest) && (
          <a class="widget glass widget--link" href={getEntryPath(featured ?? latest)}>
            <p class="widget__label">{featured ? "Start here" : "Fresh off the keyboard"}</p>
            <p class="widget__title">{(featured ?? latest).data.title}</p>
            <p class="widget__meta">{formatDate((featured ?? latest).data.pubDatetime)}</p>
          </a>
        )
      }
      {
        topics.length > 0 && (
          <section class="widget glass" aria-labelledby="topics-label">
            <p class="widget__label" id="topics-label">Rabbit holes</p>
            <ul class="widget__topics">
              {topics.map(t => (
                <li>
                  <a href={`/tags/${t.tag}/`}>
                    <span>{t.tagName}</span>
                    <span class="widget__count">{t.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <AudioControl variant="widget" />
    </aside>
  </section>

  <Panel id="recent" class="home-panel" aria-labelledby="recent-title">
    <header class="home-panel__head">
      <h2 id="recent-title" class="home-panel__title">Fresh from the monkey cage</h2>
      <a class="link-arrow" href="/posts/">See them all <Icon name="arrow-right" /></a>
    </header>
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {lead && <PostRow entry={lead} variant="lead" eager />}
          {rest.map(entry => <PostRow entry={entry} />)}
        </ul>
      ) : (
        <p class="empty hand">Nothing here yet. The monkeys are still typing.</p>
      )
    }
    <div slot="footer" class="panel__footer">
      <span>{posts.length} posts and counting</span>
      <a class="link-arrow" href="/posts/">Browse the whole pile <Icon name="arrow-right" /></a>
    </div>
  </Panel>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    min-height: min(78dvh, 760px);
    padding-block: clamp(1rem, 4vh, 3rem) clamp(2.5rem, 8vh, 5rem);
    color: var(--ground-text);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 760px;
  }

  .hero__copy > *,
  .hero__widgets > * {
    animation: hero-rise 900ms var(--ease-out) both;
  }

  .hero__copy > :nth-child(2) { animation-delay: 80ms; }
  .hero__copy > :nth-child(3) { animation-delay: 220ms; }
  .hero__copy > :nth-child(4) { animation-delay: 300ms; }
  .hero__copy > :nth-child(5) { animation-delay: 380ms; }
  .hero__widgets > :nth-child(1) { animation-delay: 250ms; }
  .hero__widgets > :nth-child(2) { animation-delay: 350ms; }
  .hero__widgets > :nth-child(3) { animation-delay: 450ms; }

  .hero__prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .hero__prompt-text {
    opacity: 0.85;
  }

  .hero__prompt-prefix {
    color: var(--accent-2);
  }

  .hero__prompt-suffix {
    opacity: 0.5;
  }

  .hero__status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #34d399;
  }

  .hero__status-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 1px solid #34d399;
    border-radius: inherit;
    animation: pulse-ring 2.2s var(--ease-out) infinite;
  }

  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: -0.3rem;
    background: var(--accent-2);
    animation: caret-blink 1.05s steps(1) infinite;
  }

  .hero__name {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .hero__name-line {
    display: block;
  }

  .hero__title-wrap {
    position: relative;
    width: fit-content;
  }

  .hero__name :global(.hero__banana) {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.06em;
    vertical-align: 0.05em;
  }

  .hero__name:hover :global(.hero__banana) {
    animation: banana-wiggle 650ms var(--ease-spring) both;
  }

  .hero__scribble {
    position: absolute;
    left: calc(100% - 0.5rem);
    bottom: 0.4em;
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    width: max-content;
    margin: 0;
    color: var(--accent-2);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    transform: rotate(-6deg);
  }

  .hero__scribble-arrow {
    width: 56px;
    height: 36px;
    flex-shrink: 0;
    transform: scaleX(-1) rotate(-10deg);
  }

  .hero__name-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ground-text) 70%, transparent);
  }

  .hero__tagline {
    max-width: 52ch;
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.85;
    text-wrap: pretty;
  }

  .hero__actions,
  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__socials {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__widgets {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .widget--link {
    display: block;
    transition: transform 200ms var(--ease-out), border-color 200ms ease;
  }

  .widget--link:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .widget__title {
    margin: 0.6rem 0 0;
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .widget__meta {
    margin: 0.6rem 0 0;
    font-size: 12.5px;
    opacity: 0.7;
  }

  .widget__topics {
    display: grid;
    gap: 2px;
    margin: 0.6rem -0.5rem 0;
    padding: 0;
    list-style: none;
  }

  .widget__topics a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
    padding: 0 0.5rem;
    border-radius: 8px;
    font-size: 14px;
  }

  .widget__topics a:hover {
    background: color-mix(in srgb, var(--glass-text) 10%, transparent);
  }

  .widget__count {
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .home-panel {
    animation-delay: 200ms;
  }

  .home-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1rem, 3vw, 2rem) 0;
  }

  .home-panel__head .link-arrow {
    white-space: nowrap;
  }

  .home-panel__title {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--prose-strong);
  }


  .empty {
    margin: 0;
    padding: 3rem 2rem;
    color: var(--muted);
    text-align: center;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }

  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  @media (max-width: 1280px) {
    .hero__scribble {
      position: static;
      margin-top: 0.75rem;
      transform: rotate(-3deg);
    }

    .hero__scribble-arrow {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__widgets {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero__widgets {
      display: none;
    }

    .hero__copy {
      gap: 1.25rem;
    }
  }
</style>
