---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import Icon from "@/components/Icon.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getEntryPath } from "@/utils/contentEntry";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries", ({ data }) => import.meta.env.DEV || !data.draft)
    : Promise.resolve([]),
]);
const posts = getSortedPosts([...blogPosts, ...galleryPosts]);

const monthFmt = new Intl.DateTimeFormat("en-GB", { month: "long", timeZone: SITE.timezone });
const dayFmt = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", timeZone: SITE.timezone });

type Group = { year: number; months: { month: string; entries: typeof posts }[] };
const years: Group[] = [];
for (const entry of posts) {
  const date = entry.data.pubDatetime;
  const year = date.getFullYear();
  const month = monthFmt.format(date);
  let y = years.find(g => g.year === year);
  if (!y) years.push((y = { year, months: [] }));
  let m = y.months.find(g => g.month === month);
  if (!m) y.months.push((m = { month, entries: [] }));
  m.entries.push(entry);
}
---

<Layout title={`Archive | ${SITE.title}`} description="Every MonkeyProof post by year and month.">
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading">Archive</h1>
      <p class="page-lede">Everything, in the order it happened. No rebase, no force-push.</p>
    </header>
    <div class="archive">
      {
        years.map(y => (
          <section class="archive__year" aria-labelledby={`y-${y.year}`}>
            <h2 class="archive__year-label" id={`y-${y.year}`}>
              {y.year}
            </h2>
            <div>
              {y.months.map(m => (
                <div class="archive__month">
                  <h3 class="archive__month-label">{m.month}</h3>
                  <ul class="archive__list">
                    {m.entries.map(entry => (
                      <li>
                        <a class="archive__item" href={getEntryPath(entry)}>
                          <time class="meta" datetime={entry.data.pubDatetime.toISOString()}>
                            {dayFmt.format(entry.data.pubDatetime)}
                          </time>
                          <span class="archive__title" transition:name={`title-${slugifyStr(entry.data.title)}`}>
                            {entry.collection === "galleries" && <Icon name="photo" label="Gallery" />}
                            {entry.data.title}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <div slot="footer" class="panel__footer">
      <span>{posts.length} posts over {years.length} {years.length === 1 ? "year" : "years"} of chaos</span>
    </div>
  </Panel>
</Layout>

<style>
  .archive {
    padding: clamp(1rem, 3vw, 2rem);
  }

  .archive__year {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding-block: 1rem 1.5rem;
  }

  .archive__year + .archive__year {
    border-top: 1px solid var(--line);
  }

  .archive__year-label {
    position: sticky;
    top: calc(var(--menubar-h) + 1.5rem);
    align-self: start;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px color-mix(in srgb, var(--window-text) 55%, transparent);
  }

  .archive__month + .archive__month {
    margin-top: 1.5rem;
  }

  .archive__month-label {
    margin: 0 0 0.4rem;
    font-family: var(--hand);
    font-size: 18px;
    font-weight: 400;
    color: var(--muted);
  }

  .archive__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive__item {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: baseline;
    gap: 1rem;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 14px;
    transition: background 160ms ease;
  }

  .archive__item:hover {
    background: var(--surface-2);
  }

  .archive__title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-weight: 500;
    color: var(--prose-strong);
  }

  .archive__item:hover .archive__title {
    color: var(--accent-text);
  }

  @media (max-width: 640px) {
    .archive__year {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .archive__year-label {
      position: static;
    }
  }
</style>
