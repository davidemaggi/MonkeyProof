---
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import Icon from "@/components/Icon.astro";
import Banana from "@/components/Banana.astro";
import { SITE } from "@/config";
---

<Layout title={`Page not found | ${SITE.title}`}>
  <Panel class="nf-panel">
    <div class="nf">
      <p class="nf__code banana-wiggle" aria-hidden="true">4<Banana size={96} />4</p>
      <h1 class="page-heading">This page went bananas.</h1>
      <p class="page-lede">It moved, never existed, or a monkey refactored it on a Friday afternoon. Search might know where it went.</p>
      <div class="nf__actions">
        <a class="action action--primary" href="/">Take me home <Icon name="arrow-right" /></a>
        <button type="button" class="action nf__search" data-open-search><Icon name="search" /> Search posts</button>
      </div>
    </div>
  </Panel>
</Layout>

<style>
  .nf-panel {
    max-width: 720px;
    margin: clamp(1rem, 8vh, 5rem) auto;
  }

  .nf {
    padding: clamp(2rem, 6vw, 3.5rem);
  }

  .nf__code {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .nf__search {
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--window-text);
  }

  .nf__code :global(.banana) {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    vertical-align: -0.02em;
  }
</style>
