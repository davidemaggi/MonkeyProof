---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex ? getCollection("galleries") : Promise.resolve([]),
]);
const posts = [...blogPosts, ...galleryPosts];
const tags = getUniqueTags(posts).map(t => ({ ...t, count: getPostsByTag(posts, t.tag).length }));
const max = Math.max(1, ...tags.map(t => t.count));
---

<Layout title={`Tags | ${SITE.title}`} description="Every topic covered on MonkeyProof.">
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading">Tags</h1>
      <p class="page-lede">{tags.length} topics. The bigger the tag, the deeper the rabbit hole.</p>
    </header>
    <ul class="tag-cloud">
      {
        tags.map(t => (
          <li>
            <a
              href={`/tags/${t.tag}/`}
              class="tag-cloud__item"
              style={`--weight: ${(t.count / max).toFixed(2)}`}
              transition:name={`tag-${t.tag}`}
            >
              <span class="tag-cloud__hash" aria-hidden="true">#</span>
              {t.tagName}
              <span class="tag-cloud__count">{t.count}<span class="sr-only"> posts</span></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div slot="footer" class="panel__footer">
      <span>{tags.length} tags</span>
    </div>
  </Panel>
</Layout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    list-style: none;
  }

  .tag-cloud__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--display);
    font-size: calc(1rem + var(--weight) * 0.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--prose-strong);
    transition: border-color 160ms ease, transform 260ms var(--ease-spring), background 160ms ease;
  }

  .tag-cloud__item:hover,
  .tag-cloud__item:focus-visible {
    transform: translateY(-2px) rotate(-3deg);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, var(--surface-2));
  }

  .tag-cloud__hash {
    color: var(--accent-text);
    font-weight: 400;
  }

  .tag-cloud__count {
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 400;
    color: var(--muted);
  }
</style>
