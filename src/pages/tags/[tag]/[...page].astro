---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Panel from "@/components/Panel.astro";
import PostRow from "@/components/PostRow.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [blogPosts, galleryPosts] = await Promise.all([
    getCollection("blog"),
    SITE.showGalleries && SITE.showGalleriesInIndex
      ? getCollection("galleries")
      : Promise.resolve([]),
  ]);
  const posts = [...blogPosts, ...galleryPosts];

  return getUniqueTags(posts).flatMap(({ tag, tagName }) =>
    paginate(getPostsByTag(posts, tag), {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    })
  );
}

const { tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<Layout title={`#${tagName} | ${SITE.title}`} description={`All the articles tagged “${tagName}”.`}>
  <Panel>
    <header class="panel-header">
      <h1 class="page-heading" transition:name={`tag-${tag}`}>
        <span class="tag-heading-hash" aria-hidden="true">#</span>{tagName}
      </h1>
      <p class="page-lede">
        {page.total} {page.total === 1 ? "post" : "posts"} down this particular rabbit hole. <a class="link-arrow" href="/tags/">Other holes</a>
      </p>
    </header>
    <ul class="post-list">
      {page.data.map(entry => <PostRow entry={entry} headingLevel="h2" />)}
    </ul>
    <Pagination slot="footer" page={page} />
  </Panel>
</Layout>

<style>
  .tag-heading-hash {
    margin-right: 0.08em;
    color: var(--accent-text);
    font-weight: 400;
  }
</style>
